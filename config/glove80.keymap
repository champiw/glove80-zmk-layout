#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define HYPER LC(LS(LG(LALT)))

// layers
#define DEFAULT 0
#define SYMBOLS 1
#define NUMPAD 2
#define MAGIC 3

/ {
    behaviors {
		n_esc: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "N_ESC_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SEMI>, <&kp ESC>;
		};

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
			// -------------------------------------------------------------------------------------------------------------------------------------------
			// |  --   |  -- |  -- |  --  |  --  |                                                               |  --   |  --   |  --  |  --  |   --  |
			// |  ESC  |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   |  '   |
			// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                                                 |  Y   |   U   |   I   |  O   |   P   | BSPC |
			// | CTRL  |  A  |  S  |  D   |  F   |  G   |                                                 |  H   |   J   |   K   |  L   | ;/ESC |  '   |
			// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   SYM   | LGUI | --  | --  | RGUI |  NUM  |     |  N   |  M   |   ,   |  .   |   -   | SHIFT |
			// | MAGIC |     |     | LEFT | RIGHT|      |  SPACE  | ALT | SYM | NUM  | RALT |  RET  |     | DOWN |  UP  |       |      |       |
			// -------------------------------------------------------------------------------------------------------------------------------------------

            bindings = <
            &none          &none    &none       &none       &none                                                                                            &none   &none       &none       &none       &none
            &kp ESC        &kp N1   &kp N2      &kp N3      &kp N4      &kp N5                                                                       &kp N6  &kp N7  &kp N8      &kp N9      &kp N0      &kp SQT
            &kp TAB        &kp Q    &kp W       &kp E       &kp R       &kp T                                                                        &kp Y   &kp U   &kp I       &kp O       &kp P       &kp BSPC
            &kp LCTRL      &kp A    &kp S       &kp D       &kp F       &kp G                                                                        &kp H   &kp J   &kp K       &kp L       &n_esc      &kp SQT
            &kp LSHFT      &kp Z    &kp X       &kp C       &kp V       &kp B   &mo SYMBOLS &kp LGUI  &none         &none      &kp RGUI  &mo NUMPAD  &kp N   &kp M   &kp COMMA   &kp DOT     &kp MINUS   &kp RSHFT
            &magic MAGIC 0 &none    &none       &kp LEFT    &kp RIGHT           &kp SPACE   &kp LALT  &mo SYMBOLS   &mo NUMPAD &kp RALT  &kp RET             &kp DOWN &kp UP     &none       &none       &none
            >;
        };

        symbols_layer {
            bindings = <
            &none          &none    &none       &none       &none                                                                                           &none     &none     &none       &none       &none
            &trans         &kp F1   &kp F2      &kp F3      &kp F4       &kp F5                                                                      &kp F6 &kp F7    &kp F8    &kp F9      &kp F10     &kp F11
            &trans         &kp LT   &kp GT      &kp DLL     &kp ASTERISK &kp PLUS                                                                 &kp PG_UP &kp PG_DN &kp HOME  &kp END     &none       &kp BSPC
            &trans         &kp LBRC &kp RBRC    &kp LBKT    &kp RBKT     &kp GRAVE                                                                 &kp LEFT &kp DOWN  &kp UP    &kp RIGHT   &kp DEL     &kp F12
            &trans         &none    &none       &none       &none       &none   &mo SYMBOLS  &kp LGUI  &none        &none      &kp RGUI &mo NUMPAD  &kp G   &none     &none     &none       &none       &none
            &trans         &none    &none       &trans      &trans              &kp SPACE    &kp LALT  &mo SYMBOLS  &mo NUMPAD &kp RALT &kp RET             &trans    &trans    &none       &none       &none
            >;
        };

        numpad_layer {
            bindings = <
            &none          &none    &none       &none       &none                                                                                             &none     &none   &none   &none    &none
            &trans         &kp F1   &kp F2      &kp F3      &kp F4      &kp F5                                                                       &kp LEFT &kp RIGHT &none   &kp F9  &kp F10  &kp F11
            &trans         &none    &none       &none       &none       &none                                                                        &kp UP   &kp N7    &kp N8  &kp N9  &none    &kp BSPC 
            &trans         &none    &none       &none       &none       &none                                                                        &kp DOWN &kp N4    &kp N5  &kp N6  &kp N0   &kp F17
            &trans         &none    &none       &none       &none       &none   &mo SYMBOLS  &kp LGUI  &none        &none       &kp RGUI &mo NUMPAD  &kp N    &kp N1    &kp N2  &kp N3  &kp F15  &kp F16
            &trans         &none    &none       &kp LEFT    &kp RIGHT           &kp SPACE    &kp LALT  &mo SYMBOLS  &mo NUMPAD  &kp RALT &kp RET     &kp DOWN &kp UP    &none   &none   &none
            >;
        };

        magic_layer {
            bindings = <
            &bt BT_CLR        &none               &none           &none           &none                                                                                                           &none      &none      &none      &none      &bt BT_CLR_ALL
            &none             &none               &none           &none           &none           &none                                                                                &none      &none      &none      &none      &none      &none
            &none             &rgb_ug RGB_SPI     &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                      &none      &none      &none      &none      &none      &none
            &bootloader       &rgb_ug RGB_SPD     &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                      &none      &none      &none      &none      &none      &bootloader
            &sys_reset        &none               &none           &none           &none           &none           &bt_2     &bt_3     &none            &none     &none     &none       &none      &none      &none      &none      &none      &sys_reset
            &none             &none               &none           &none           &none                           &bt_0     &bt_1     &out OUT_USB     &none     &none     &none                  &none      &none      &none      &none      &none
            >;
        };

    };
};
